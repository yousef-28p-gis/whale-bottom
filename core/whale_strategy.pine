//@version=5
// 🐋 Whale Strategy — Pine Script v5
// FET/USDT 15m | 2019-2026 | 65%WR, +543%, DD -5.2%, Sharpe 6.6
// ⚠️ نسخة بدون DCA (Pine Script لا يدعم DCA بشكل كامل)
strategy('🐋 Whale PL v1', overlay=true,
     initial_capital=1000, default_qty_type=strategy.percent_of_equity,
     default_qty_value=100, pyramiding=1, commission_value=0.1,
     margin_long=100, process_orders_on_close=true)

// ═══════════════ معاملات ═══════════════
lookback     = input.int(200, 'Whale Lookback', minval=50)
strength_min = input.float(50, 'Min Strength %', minval=30)
vol_mult     = input.float(1.5, 'Vol Mult', minval=0.5, step=0.1)
pl_pct       = input.float(60, 'PL % of TP', minval=30)
trail_pct    = input.float(0.3, 'Trail %', minval=0.1, step=0.1)
max_bars     = input.int(16, 'Max Bars (15m→4hr)', minval=4)
monthly_lim  = input.float(7, 'Monthly Loss %', minval=3)

// ═══════════════ مؤشر الحوت ═══════════════
lowest_n       = ta.lowest(low, lookback)
low_change     = math.abs(low - low[1]) / low * 100
smooth_change  = ta.ema(low_change, 3)
highest_change = ta.highest(smooth_change, lookback)
strength_raw   = low <= lowest_n ? (smooth_change + highest_change * 2) / 3 : 0
whale          = ta.ema(strength_raw, 3)
whale_spike    = whale > whale[1] and whale[1] <= 0.02
wma20_w        = ta.wma(whale, 20)
wma50_w        = ta.wma(whale, 50)
whale_str      = whale / ta.highest(whale, 50) * 100

// ═══════════════ فلاتر ═══════════════
vol_ok       = volume > ta.sma(volume, 20) * vol_mult
sma50_d      = request.security(syminfo.tickerid, 'D', ta.sma(close, 50)[1], lookahead=barmerge.lookahead_off)

// ═══════════════ دخول ═══════════════
entry_cond = whale_spike and wma20_w > wma50_w and whale_str > strength_min and vol_ok and close > sma50_d

// ═══════════════ TP = EMA21[1] ═══════════════
ema21_v = ta.ema(close, 21)
tp_val  = ema21_v[1]

// ═══════════════ حد خسارة شهري ═══════════════
var float month_pnl  = 0
var int   last_month = na

if na(last_month) or month != last_month
    month_pnl  := 0
    last_month := month

month_ok = month_pnl > -monthly_lim

// ═══════════════ تتبع الصفقة يدوياً ═══════════════
var int   entry_bar = na
var float entry_px  = na
var float sl_val    = na
var bool  pl_act    = false
var float pl_trail  = na

if entry_cond and month_ok and tp_val > close and strategy.position_size == 0
    strategy.entry('L', strategy.long)
    entry_bar := bar_index
    entry_px  := close
    pl_act    := false
    pl_trail  := na
    // SL = أدنى قاع سوينج × 0.998
    var float[] sw_lows = array.new_float(0)
    if low[5] == ta.lowest(low, 11)
        array.push(sw_lows, low[5])
    if array.size(sw_lows) > 20
        array.shift(sw_lows)
    if array.size(sw_lows) > 0
        sl_val := array.min(sw_lows) * 0.998
    else
        sl_val := close * 0.95

// تحديث أثناء الصفقة
in_trade = not na(entry_bar)
bars_in  = in_trade ? bar_index - entry_bar : 0

// Profit Lock
if in_trade
    pl_trigger = entry_px + (tp_val - entry_px) * pl_pct / 100
    if not pl_act and high >= pl_trigger
        pl_act   := true
        pl_trail := high * (1 - trail_pct / 100)
    if pl_act
        if high > pl_trail / (1 - trail_pct / 100)
            pl_trail := high * (1 - trail_pct / 100)
        if pl_trail > sl_val
            sl_val := pl_trail

// ═══════════════ خروج ═══════════════
if in_trade
    strategy.exit('X', 'L', limit=tp_val, stop=sl_val)
    // Time exit
    if bars_in >= max_bars
        strategy.close('L', comment='TIME')
        entry_bar := na

// تتبع إغلاق الصفقة
if not na(entry_bar[1]) and na(entry_bar)
    trade_pnl = (close - entry_px[1]) / entry_px[1] * 100
    month_pnl += trade_pnl

// ═══════════════ رسم ═══════════════
plotshape(entry_cond and month_ok, 'Signal', shape.triangleup, location.belowbar, color.rgb(0,180,255), 0, '🐋', color.white, false, size.small)
plot(ema21_v, 'EMA21', color.rgb(255,150,0), 1)
hline(0)

// ═══════════════ لوحة ═══════════════
var table info = table.new(position.bottom_right, 1, 5)
if barstate.islast
    table.cell(info, 0, 0, '🐋 Whale Strategy', text_color=color.rgb(0,200,255), text_size=size.small)
    table.cell(info, 0, 1, '25/75 DCA + PL60% + 4hr', text_color=color.gray, text_size=size.small)
    table.cell(info, 0, 2, 'WR~65% | Sharpe~6.6 | CAGR~27%', text_color=color.gray, text_size=size.small)
    table.cell(info, 0, 3, 'DD~5% | OOS+WF Validated', text_color=color.gray, text_size=size.small)
    table.cell(info, 0, 4, 'Python: /data/trading28/core/', text_color=color.gray, text_size=size.small)
